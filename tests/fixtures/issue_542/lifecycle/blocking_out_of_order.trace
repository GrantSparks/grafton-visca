1 effect admitted ticket=a id=1 target=1 permit=acquired state=ready observer=blocking
1 outcome admission ticket=a id=1
1 effect state id=1 from=ready to=sending
1 effect transmit tx=1 id=1 kind=request target=1 wire=81010604ff
1 driver-input transmission-finished tx=1 result=ok
1 effect state id=1 from=sending to=awaiting-ack
1 outcome blocking-handle ticket=a id=1 initial-write=complete
